POSTGRES_PASSWORD=replace-with-a-local-database-password
MIGRATION_DATABASE_URL=postgresql://nucleo:replace-with-a-local-database-password@127.0.0.1:5549/nucleo
DATABASE_URL=postgresql://nucleo_app:replace-with-a-distinct-application-password@127.0.0.1:5549/nucleo
RUNNER_DATABASE_URL=postgresql://nucleo_runner:replace-with-a-distinct-runner-password@127.0.0.1:5549/nucleo
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
PUBLIC_ORIGIN=http://localhost:3050
API_INTERNAL_URL=http://127.0.0.1:3060
API_PORT=3060
# Same value in the API and in the Vercel project (openssl rand -hex 32). Leave unset locally.
# API_PROXY_SECRET=
BOOK_DISTRIBUTION_AUTHORIZED=false
RUNNER_ENABLED=true
RUNNER_DOCKER_RUNTIME=runsc
# Only for local machines without gVisor: RUNNER_DOCKER_RUNTIME=runc requires this flag.
RUNNER_ALLOW_RUNC=false
RUNNER_ARTIFACT_DIR=/absolute/path/to/engenharia-reversa-platform/.runtime/artifacts
RUNNER_CONCURRENCY=2

# Exact origins; production previews must use a staging API and staging database.
WEB_ORIGINS=
NATIVE_CLIENTS_ENABLED=true
# Optional password recovery (both values required)
# RESEND_API_KEY=
# EMAIL_FROM=Núcleo <conta@seudominio.com>
# Public HTTPS URL embedded into installed builds; this is not a secret.
# NUCLEO_API_URL=https://api.seudominio.com
