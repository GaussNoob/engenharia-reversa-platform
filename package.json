{
  "name": "nucleo-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node --env-file=.env --import tsx scripts/dev.ts",
    "content:import": "node scripts/python.mjs scripts/import_book.py",
    "db:migrate": "node --env-file=.env --import tsx apps/api/src/db/migrate.ts",
    "db:seed": "node --env-file=.env --import tsx apps/api/src/db/seed.ts",
    "build": "npm run build --workspace @nucleo/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:integration": "vitest run --config tests/integration/vitest.config.ts",
    "test:e2e": "playwright test",
    "check:content": "node scripts/python.mjs scripts/validate_plan.py && node scripts/python.mjs scripts/validate_content.py",
    "assets:prepare": "node scripts/prepare-assets.mjs",
    "runner:build": "node scripts/build-model-runner.mjs",
    "format": "prettier --write apps packages scripts/*.ts scripts/*.mjs tests playwright.config.ts vitest.config.ts",
    "dev:web": "npm run dev -w @nucleo/web",
    "dev:api": "npm run dev -w @nucleo/api",
    "dev:desktop": "npm run dev -w @nucleo/desktop",
    "dev:mobile": "npm run dev -w @nucleo/mobile",
    "build:web": "npm run assets:prepare && npm run build -w @nucleo/web",
    "build:desktop": "npm run build -w @nucleo/desktop",
    "build:desktop:ui": "npm run build:ui -w @nucleo/desktop",
    "build:mobile": "npm run build -w @nucleo/mobile",
    "build:android": "npm run build:android -w @nucleo/mobile",
    "build:aab": "npm run build:aab -w @nucleo/mobile",
    "test:shells": "playwright test --config tests/shells/playwright.config.ts",
    "lint": "node scripts/lint.mjs",
    "test:web-ui": "playwright test --config tests/web-ui/playwright.config.ts",
    "build:api": "node scripts/build-api.mjs",
    "icons:prepare": "node scripts/prepare-icons.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "dompurify": "3.4.16",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "overrides": {
    "dompurify": "3.4.16",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  },
  "engines": {
    "node": ">=24.0.0 <27"
  }
}
