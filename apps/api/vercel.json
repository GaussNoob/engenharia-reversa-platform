{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "hono",
  "installCommand": "cd ../.. && npm ci",
  "buildCommand": "node ../../scripts/prepare-api-content.mjs",
  "functions": {
    "src/app.ts": {
      "maxDuration": 30,
      "includeFiles": "{../../content/**,../../references/fundamentos-engenharia-reversa/.gitbook/assets/**}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    }
  ],
  "regions": ["gru1"]
}
