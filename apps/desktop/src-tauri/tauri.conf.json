{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Núcleo",
  "version": "0.1.0",
  "identifier": "com.nucleo.estudo.desktop",
  "build": {
    "beforeDevCommand": "node ../../scripts/build-native.mjs desktop --serve",
    "devUrl": "http://localhost:3070",
    "beforeBuildCommand": "npm run build:ui",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Núcleo — sua bancada",
        "width": 1360,
        "height": 900,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
